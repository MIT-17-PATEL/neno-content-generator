# AI Content Studio — Environment Configuration Template
# Copy this to .env.local for local development

# Database (PostgreSQL / AWS RDS)
# Replace with your AWS RDS Endpoint:
DATABASE_URL=postgresql://username:password@your-rds-endpoint.rds.amazonaws.com:5432/your_database_name?sslmode=require

# Authentication Secret (32+ character string)
AUTH_SECRET=ai-content-studio-default-dev-secret-key-32chars

# AI & LLM Providers
AI_PROVIDER_API_KEY=
GEMINI_API_KEY=
RESEARCH_PROVIDER_API_KEY=
IMAGE_PROVIDER_API_KEY=

# Object Storage (AWS S3)
S3_BUCKET=ai-content-studio-assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Target Website Integration (Neno Tech Website)
NENO_WEBSITE_URL=https://www.nenotechnology.com
NENO_WEBSITE_ADMIN_EMAIL=admin@nenotechnology.com
NENO_WEBSITE_ADMIN_PASSWORD=

# Application URL
APP_URL=http://localhost:3001
NEXT_PUBLIC_DEMO_MODE=false

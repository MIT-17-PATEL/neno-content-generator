# AI Content Studio — Environment Configuration Template
# Copy this to .env.local for local development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_content_studio

# Authentication Secret
AUTH_SECRET=your-random-32-character-secret-key-here

# AI & LLM Providers (Server-side ONLY)
AI_PROVIDER_API_KEY=
RESEARCH_PROVIDER_API_KEY=
IMAGE_PROVIDER_API_KEY=

# Object Storage (S3 Compatible)
S3_BUCKET=ai-content-studio-assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Target Website Integration (Neno Tech Website)
NENO_WEBSITE_URL=http://localhost:3000
NENO_WEBSITE_ADMIN_EMAIL=admin@neno.tech
NENO_WEBSITE_ADMIN_PASSWORD=admin123

# Application URL
APP_URL=http://localhost:3001

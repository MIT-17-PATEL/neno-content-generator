# Neno Content Engine — environment variables
# Copy to .env.local for local development. Never commit real values (this file is public in git).

# ---------------------------------------------------------------- required
# PostgreSQL connection string, must be reachable from where the app runs (Vercel: a public host, not localhost)
# format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=
# Session signing key, 32+ random characters (e.g. `openssl rand -hex 32`). Required in production.
AUTH_SECRET=
# Admin login. In production the admin can only sign in with ADMIN_PASSWORD (12+ characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Neno website the posts are published to, and the shared key it expects in the x-api-key header
NENO_WEBSITE_URL=https://www.nenotechnology.com
CONTENT_ENGINE_API_KEY=
# At least one LLM key. Gemini is also used for photo covers (gemini-2.5-flash-image) and stock-photo scoring.
GEMINI_API_KEY=
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to /api/admin/trash/cleanup (16+ random chars)
CRON_SECRET=

# ---------------------------------------------------------------- optional
# Other LLM providers (used instead of / before Gemini when set)
OPENROUTER_API_KEY=
AI_PROVIDER_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Model overrides
AI_MODEL=
IMAGE_MODEL=gemini-2.5-flash-image
VISION_MODEL=gemini-2.5-flash
# Stock photos (licensed APIs only). Pexels: https://www.pexels.com/api/ · Unsplash: https://unsplash.com/developers
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
UNSPLASH_APP_NAME=neno_content_engine
# Admin display name
ADMIN_NAME=
# Allow public self sign-up in production (default off). Users are in-memory only, so leave this off.
ALLOW_SIGNUP=false
# Shows the one-click demo login. Must stay false in production.
NEXT_PUBLIC_DEMO_MODE=false
# Sent as HTTP-Referer to OpenRouter (public, not a secret)
NEXT_PUBLIC_WEBSITE_URL=https://www.nenotechnology.com
# Diagrams need a full Chrome. Set this to a Chrome binary to enable diagrams where it exists (not on Vercel).
PUPPETEER_EXECUTABLE_PATH=
# Build-time on Vercel: skip Puppeteer's ~150 MB Chrome download, which can't be used there anyway
PUPPETEER_SKIP_DOWNLOAD=

# ---------------------------------------------------------------- legacy aliases / local only
# NENO_WEBSITE_API_URL=        (alias of NENO_WEBSITE_URL)
# NENO_CONTENT_ENGINE_API_KEY= (alias of CONTENT_ENGINE_API_KEY)
# PORT=3000                    (local dev only; Vercel sets it)
